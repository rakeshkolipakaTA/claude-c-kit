#!/usr/bin/env python3
"""Stop / SubagentStop hook (generated by cckit): append the token counts of every new response to a local CSV.

After each turn Claude Code runs this script and sends JSON on stdin (session_id, transcript_path, and for subagents agent_transcript_path).
Only NUMBERS are written (timestamp, session, message id, model, token counts): never prompts, code or replies. The CSV stays on this machine and is
git-ignored (cckit init adds it to .gitignore). It prints nothing and never blocks. Opt out with CCKIT_USAGE_LOG=off.

Each run reads only what was added to the transcript since the last run (an offset per transcript in <csv>.state.json), and a message id is never
written twice, so repeated Stop events, parallel sessions and a lost state file cannot create duplicates.
Columns: timestamp, session_id, message_id, model, input_tokens, output_tokens, cache_write_tokens, cache_read_tokens, subagent (yes/no)

Reporting (only when [telemetry] stop_report is on and this machine is registered): the same numbers are added up per model and sent to the team's
usage API as trigger "stop" events, at most once every `stop_interval` seconds (default: every Stop). An event holds the company e-mail and token, the model, the token counts since the previous
event (main + subagents), request counts, how many times this hook fired (turns) and how many seconds the turn took from the prompt to the last line, how many minutes the session has been running, the current model, effort, Claude Code version, entrypoint, branch and the tool names used, the current context size, the repo folder name and the session id: no prompts, code or replies. Events
that could not be delivered wait in the state file (at most 200, retried with a growing pause) and are sent with a fixed event id, so a retry
never counts twice. Opt out on one machine with CCKIT_TELEMETRY=off.
"""
import csv
import io
import json
import os
import sys
import platform
import time
from collections import Counter
from datetime import datetime
import urllib.request
import uuid
from pathlib import Path

CSV_PATH = __CSV_PATH__
WRITE_CSV = __WRITE_CSV__
STOP_REPORT = __STOP_REPORT__
ENDPOINT = __ENDPOINT__              # identifies the team's API in the identity file
USAGE_URL = __USAGE_URL__
WINDOW = __WINDOW__
SEND_PROJECT = __SEND_PROJECT__
FLUSH_EVERY = __FLUSH_EVERY__                   # minimum seconds between events (cckit.toml [telemetry] stop_interval; 0 = one event per Stop)
OUTBOX_MAX = 200
SEND_AT_MOST = 5                     # events sent per run

COLUMNS = ["timestamp", "session_id", "message_id", "model", "input_tokens", "output_tokens", "cache_write_tokens", "cache_read_tokens", "subagent"]
RECENT = 200            # message ids remembered in the state file, against a message split across two runs


def load_json(p):
    try:
        d = json.loads(Path(p).read_text(encoding="utf-8"))
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def logged_ids(csv_file):
    ids = set()
    try:
        with open(csv_file, newline="", encoding="utf-8") as f:
            for row in csv.reader(f):
                if len(row) > 2:
                    ids.add(row[2])
    except OSError:
        pass
    return ids


class Lock:
    """A lock file next to the CSV: parallel sessions take turns, so the header is written once and no offset is lost. A lock left behind by a
    crashed process is ignored after 10 seconds. If the lock cannot be had within 3 seconds this run does nothing: the rows stay in the transcript
    and the next event logs them."""

    def __init__(self, target):
        self.path = str(target) + ".lock"
        self.held = False

    def __enter__(self):
        deadline = time.time() + 3
        while True:
            try:
                os.close(os.open(self.path, os.O_CREAT | os.O_EXCL | os.O_WRONLY))
                self.held = True
                return self
            except FileExistsError:
                try:
                    if time.time() - os.path.getmtime(self.path) > 10:
                        os.unlink(self.path)
                        continue
                except OSError:
                    continue
                if time.time() > deadline:
                    return self
                time.sleep(0.02)
            except OSError:
                return self

    def __exit__(self, *exc):
        if self.held:
            try:
                os.unlink(self.path)
            except OSError:
                pass


def settle(path, pause=0.1, tries=8):
    """Claude Code can fire Stop a moment before the last response is flushed to the transcript: wait until its size stops changing."""
    prev = -1
    for _ in range(tries):
        try:
            size = os.path.getsize(path)
        except OSError:
            return
        if size == prev:
            return
        prev = size
        time.sleep(pause)


def ts(v):
    try:
        return datetime.fromisoformat(str(v).replace("Z", "+00:00"))
    except Exception:
        return None


def first_timestamp(path):
    """When the session began: the first timestamp near the top of its transcript."""
    try:
        with open(path, "rb") as f:
            head = f.read(65536)
    except OSError:
        return None
    for raw in head.splitlines()[:40]:
        if b'"timestamp"' in raw:
            try:
                t = ts(json.loads(raw).get("timestamp"))
            except (ValueError, AttributeError):
                continue
            if t:
                return t
    return None


def is_prompt(o, m):
    """A line the developer typed (not a tool result, not a subagent, not a system line)."""
    if o.get("type") != "user" or o.get("isSidechain") or o.get("isMeta") or o.get("isCompactSummary") or not isinstance(m, dict):
        return False
    c = m.get("content")
    return bool(c.strip()) if isinstance(c, str) else isinstance(c, list) and any(isinstance(b, dict) and b.get("type") == "text" for b in c)


def new_rows(path, force_sub, offsets, seen, session, meta=None):
    """Rows for the responses added to one transcript since the last run. Moves this transcript's offset past the complete lines it read.
    `meta` (the main transcript only) is filled with the facts of the newest turn: when the prompt was typed and when the last line was written,
    the tool names used, and the model, effort, version, entrypoint and branch of the newest main response."""
    size = os.path.getsize(path)
    off = int(offsets.get(path) or 0)
    if off > size:
        off = 0
    with open(path, "rb") as f:
        f.seek(off)
        chunk = f.read()
    end = chunk.rfind(b"\n")
    if end < 0:
        return []                                       # no complete line yet
    chunk = chunk[: end + 1]
    known = set(seen) | (logged_ids(CSV_FILE[0]) if off == 0 else set())
    last, tools = {}, {}
    for raw in chunk.splitlines():
        usage = b'"usage"' in raw
        if not usage and (meta is None or b'"user"' not in raw):
            continue
        try:
            o = json.loads(raw)
        except ValueError:
            continue
        if not isinstance(o, dict):
            continue
        m = o.get("message")
        if meta is not None:
            t = None if o.get("isSidechain") else ts(o.get("timestamp"))
            if t:
                meta["end"] = t
                if is_prompt(o, m):
                    meta["start"] = t
                    tools.clear()                       # tools of an earlier turn in this chunk do not belong to the newest turn
        if o.get("type") != "assistant" or not isinstance(m, dict) or not isinstance(m.get("usage"), dict):
            continue
        model = str(m.get("model") or "")
        mid = str(m.get("id") or o.get("uuid") or "")
        if not model or model.startswith("<") or not mid:
            continue
        u = m["usage"]
        last[mid] = [str(o.get("timestamp") or ""), str(o.get("sessionId") or session), mid, model, int(u.get("input_tokens") or 0),
                     int(u.get("output_tokens") or 0), int(u.get("cache_creation_input_tokens") or 0), int(u.get("cache_read_input_tokens") or 0),
                     "yes" if (force_sub or o.get("isSidechain")) else "no"]    # a response is written once per content block: the last line is final
        if meta is not None and not o.get("isSidechain"):
            meta["current_model"] = model
            for k, src in (("effort", "effort"), ("claude_version", "version"), ("entrypoint", "entrypoint"), ("branch", "gitBranch")):
                if o.get(src):
                    meta[k] = str(o[src])[:60]
            for b in (m.get("content") if isinstance(m.get("content"), list) else []):
                if isinstance(b, dict) and b.get("type") == "tool_use" and b.get("id"):
                    tools[b["id"]] = str(b.get("name") or "")[:40]
    offsets[path] = off + end + 1
    if meta is not None:
        meta["tools"] = dict(Counter(tools.values()))
    return [r for mid, r in last.items() if mid not in known]


# ------------------------------------------------------------------ reporting to the team's usage API
def identity_path():
    env = os.environ.get("CCKIT_IDENTITY_FILE")
    if env:
        return Path(env)
    base = os.environ.get("XDG_CONFIG_HOME") or os.environ.get("APPDATA") or str(Path.home() / ".config")
    return Path(base) / "cckit" / "identity.json"


def load_identity():
    rec = load_json(identity_path()).get(ENDPOINT)
    return rec if isinstance(rec, dict) and rec.get("email") and rec.get("token") else None


def add_pending(state, rows):
    """Add the new rows to the per-model totals waiting for the next event."""
    pend = state.get("pending") if isinstance(state.get("pending"), dict) else {}
    for r in rows:
        p = pend.setdefault(r[3], {"i": 0, "o": 0, "cw": 0, "cr": 0, "req": 0, "sreq": 0, "sout": 0, "ctx": 0, "session": ""})
        p["i"] += r[4]
        p["o"] += r[5]
        p["cw"] += r[6]
        p["cr"] += r[7]
        p["session"] = r[1] or p["session"]
        if r[8] == "yes":
            p["sreq"] += 1
            p["sout"] += r[5]
        else:
            p["req"] += 1
            p["ctx"] = r[4] + r[6] + r[7]               # the prompt size of the newest main response = the context window in use
    state["pending"] = pend


def add_turn(state, meta):
    """Facts about the turn(s) waiting for the next event: seconds from the prompt to the end of the answer, tools used, current model and settings."""
    t = state.get("turn") if isinstance(state.get("turn"), dict) else {}
    if meta.get("session_start") and meta.get("end"):
        t["session_minutes"] = max(0, int((meta["end"] - meta["session_start"]).total_seconds() // 60))      # since the session began: a running total
    if meta.get("start") and meta.get("end"):
        t["duration_s"] = int(t.get("duration_s") or 0) + max(0, int((meta["end"] - meta["start"]).total_seconds()))
    tools = t.get("tools") if isinstance(t.get("tools"), dict) else {}
    for k, v in (meta.get("tools") or {}).items():
        tools[k] = int(tools.get(k) or 0) + v
    t["tools"] = tools
    for k in ("current_model", "effort", "claude_version", "entrypoint", "branch"):
        if meta.get(k):
            t[k] = meta[k]
    state["turn"] = t


def flush_pending(state, now, project):
    """Turn the waiting totals into events (one per model, each with a fixed id) when a minute has passed since the last ones.
    "turns" = how many times the Stop hook fired since the previous event; it is put on one event only (the model that wrote the most), so that
    summing the events never counts a turn twice."""
    pend = state.get("pending")
    if not pend or now - float(state.get("last_flush") or 0) < FLUSH_EVERY:
        return
    box = state.get("outbox") if isinstance(state.get("outbox"), list) else []
    main = max(pend, key=lambda k: pend[k]["o"])
    t = state.get("turn") if isinstance(state.get("turn"), dict) else {}
    tools = t.get("tools") if isinstance(t.get("tools"), dict) else {}
    for model, p in pend.items():
        first = model == main                                 # turns, duration and tool counts go on one event only, so that sums stay right
        box.append({"event_id": uuid.uuid4().hex, "trigger": "stop", "model": model, "turns": int(state.get("stops") or 0) if first else 0,
                    "duration_s": int(t["duration_s"]) if first and "duration_s" in t else None,
                    "session_minutes": t.get("session_minutes") if first else None, "current_model": t.get("current_model") or main,
                    "effort": t.get("effort", ""), "claude_version": t.get("claude_version", ""), "entrypoint": t.get("entrypoint", ""),
                    "branch": t.get("branch", "") if SEND_PROJECT else "", "tool_calls": sum(tools.values()) if first else 0,
                    "tools": ";".join("%s:%d" % kv for kv in sorted(tools.items(), key=lambda kv: -kv[1])[:8]) if first else "",
                    "input_tokens": p["i"], "output_tokens": p["o"], "cache_read": p["cr"], "cache_write": p["cw"], "requests": p["req"], "sub_requests": p["sreq"], "sub_output": p["sout"],
                    "context_tokens": p["ctx"], "window": WINDOW, "project": project, "session": p["session"], "os": platform.system(),
                    "client": "cckit-stop/2"})
        box[-1] = {k: v for k, v in box[-1].items() if v is not None}       # an unknown duration is left out (stored as empty), never sent as 0
    state["stops"] = 0
    state["turn"] = {}
    state["outbox"] = box[-OUTBOX_MAX:]
    state["pending"] = {}
    state["last_flush"] = now


def post(url, payload, timeout):
    req = urllib.request.Request(url, data=json.dumps(payload).encode("utf-8"), method="POST",
                                 headers={"Content-Type": "text/plain;charset=utf-8", "User-Agent": "cckit"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        d = json.loads(r.read().decode("utf-8", "replace"))
    return d if isinstance(d, dict) else {}


def send_outbox(csv_file, state_file, ident):
    """Send the waiting events (outside the lock: the network must not hold up other sessions), then forget the delivered ones."""
    state = load_json(state_file)
    box = state.get("outbox") if isinstance(state.get("outbox"), list) else []
    if not box or time.time() < float(state.get("next_try") or 0):
        return
    sent, failed, deadline = set(), False, time.time() + 9
    for e in box[:SEND_AT_MOST]:
        if time.time() > deadline:
            break
        try:
            d = post(USAGE_URL, dict(e, v=1, email=ident["email"], token=ident["token"]), 4)
        except Exception:
            failed = True
            break
        if not d.get("ok"):
            failed = True                               # rate limit, bad token, switched off...: keep the events and pause
            break
        sent.add(e["event_id"])
    with Lock(csv_file) as lock:
        if not lock.held:
            return                                      # the events stay and are sent again with the same ids: the server ignores repeats
        state = load_json(state_file)
        state["outbox"] = [e for e in (state.get("outbox") or []) if e.get("event_id") not in sent]
        fails = 0 if not failed else int(state.get("fails") or 0) + 1
        state["fails"] = fails
        state["next_try"] = 0 if not failed else time.time() + min(3600, 60 * 2 ** min(fails, 6))
        write_state(state_file, state)


def write_state(state_file, state):
    tmp = state_file.with_name(state_file.name + ".%d.tmp" % os.getpid())
    tmp.write_text(json.dumps(state), encoding="utf-8")
    os.replace(tmp, state_file)


CSV_FILE = [None]       # set in main(); a list so that new_rows can read it without another argument


def main():
    if os.environ.get("CCKIT_USAGE_LOG", "").lower() in ("off", "0", "false", "no"):
        return
    try:
        data = json.load(sys.stdin)
        sub_event = data.get("hook_event_name") == "SubagentStop"
        tpath = data.get("agent_transcript_path") if sub_event else data.get("transcript_path")
        if not tpath or not os.path.isfile(tpath):
            return
        root = Path(os.environ.get("CLAUDE_PROJECT_DIR") or data.get("cwd") or ".")
        csv_file = Path(CSV_PATH) if os.path.isabs(CSV_PATH) else root / CSV_PATH
        CSV_FILE[0] = csv_file
        state_file = csv_file.with_name(csv_file.name + ".state.json")
        csv_file.parent.mkdir(parents=True, exist_ok=True)
        settle(tpath)                                       # outside the lock: waiting must not block other sessions
        with Lock(csv_file) as lock:
            if not lock.held:
                return
            state = load_json(state_file)
            offsets = state.get("offsets") if isinstance(state.get("offsets"), dict) else {}
            recent = state.get("recent") if isinstance(state.get("recent"), list) else []
            # the transcript of this event, plus every subagent transcript of the session: a subagent's last lines are often flushed after its own
            # SubagentStop, and no later event would come for it
            paths = [(tpath, sub_event)]
            if not sub_event:
                paths += [(str(f), True) for f in sorted(Path(tpath[: -len(".jsonl")] if tpath.endswith(".jsonl") else tpath).glob("subagents/*.jsonl"))]
            session = str(data.get("session_id") or "")
            rows, seen, meta = [], set(recent), {}
            for path, force_sub in paths:
                try:
                    got = new_rows(path, force_sub, offsets, seen, session, None if force_sub else meta)
                except OSError:
                    continue
                rows += got
                seen |= {r[2] for r in got}
            if rows and WRITE_CSV:
                buf = io.StringIO()
                w = csv.writer(buf, lineterminator="\n")
                if not csv_file.exists() or csv_file.stat().st_size == 0:
                    w.writerow(COLUMNS)
                w.writerows(rows)
                with open(csv_file, "a", encoding="utf-8", newline="") as f:
                    f.write(buf.getvalue())
            ident = load_identity() if STOP_REPORT and USAGE_URL and os.environ.get("CCKIT_TELEMETRY", "").lower() not in ("off", "0", "false", "no") else None
            state["offsets"], state["recent"] = offsets, (recent + [r[2] for r in rows])[-RECENT:]
            if ident:                                       # nothing is collected for sending until this machine is registered
                add_pending(state, rows)
                if not sub_event:
                    state["stops"] = int(state.get("stops") or 0) + 1       # one turn of the main agent
                    meta["session_start"] = first_timestamp(tpath)
                    add_turn(state, meta)
                flush_pending(state, time.time(), os.path.basename(str(root).rstrip("/\\")) if SEND_PROJECT else "")
            write_state(state_file, state)
        if ident:
            send_outbox(csv_file, state_file, ident)
    except Exception:
        pass


if __name__ == "__main__":
    main()
