#!/usr/bin/env python3
"""Status line (generated by cckit): model, context used, session cost, and a warning when the context is large.

Claude Code runs this script and sends session data as JSON on stdin; whatever we print is shown at the
bottom of the screen. Every field is optional, so a missing one never breaks the line.
"""
import json
import sys

WARN_PCT = __WARN_PCT__


def get(d, *path, default=None):
    for p in path:
        if not isinstance(d, dict) or p not in d:
            return default
        d = d[p]
    return d


def main() -> None:
    try:
        data = json.load(sys.stdin)
    except Exception:
        data = {}
    model = get(data, "model", "display_name", default="") or get(data, "model", "id", default="") or "Claude"
    parts = [f"[{model}]"]
    pct = get(data, "context_window", "used_percentage")
    if isinstance(pct, (int, float)):
        txt = f"ctx {pct:.0f}%"
        if pct >= WARN_PCT:
            txt += " - /compact or /clear soon"
        parts.append(txt)
    cost = get(data, "cost", "total_cost_usd")
    if isinstance(cost, (int, float)):
        parts.append(f"${cost:.2f}")
    sys.stdout.write(" ".join(parts) + "\n")


if __name__ == "__main__":
    main()
