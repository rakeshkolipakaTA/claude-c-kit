/**
 * Claude usage: PULL mode. Generated by `cckit api export --mode puller` (claude-cost-kit); do not edit by hand.
 *
 * Use this when Apps Script cannot be a public web app (the usual case in a company that forbids "Anyone" deployments). Developers' hooks post
 * to a `cckit server` that you host somewhere public; this script runs on a time trigger as YOU, calls that server (outbound only) and copies
 * new rows into two tabs of this spreadsheet:
 *   Claude_Compactions   one row per context compaction (appended; a cursor remembers the last row copied)
 *   Claude_Users         the registered developers (replaced on every pull; the server is the source of truth)
 * No web app deployment is needed. Which spreadsheet: Script Property USAGE_SHEET_ID, else SHEET_ID (the Access Hub sets it), else the bound one.
 *
 * Setup once: run setupUsagePull (menu "Set up Claude usage pull"): it asks for the server URL and the admin token (CCKIT_ADMIN_TOKEN on the server),
 * stores them as Script Properties and installs a trigger that runs pullClaudeUsage every 15 minutes.
 */

const PULL = { EVENTS: 'Claude_Compactions', USERS: 'Claude_Users', PAGE: 500, MAX_PAGES: 20, EVERY_MINUTES: 15 };

function setupUsagePull() {
  const ui = SpreadsheetApp.getUi();
  const props = PropertiesService.getScriptProperties();
  const ask = function (title, text) {
    const r = ui.prompt(title, text, ui.ButtonSet.OK_CANCEL);
    return r.getSelectedButton() === ui.Button.OK ? r.getResponseText().trim() : null;
  };
  const url = ask('Usage server URL', 'Address of your cckit server, for example https://usage.example.com (https only).\nCurrent: ' + (props.getProperty('USAGE_SERVER_URL') || '(none)'));
  if (url === null) return;
  if (!/^https:\/\/[^\s]+$/i.test(url)) { ui.alert('The URL must start with https://'); return; }
  const token = ask('Admin token', 'The server\'s CCKIT_ADMIN_TOKEN (stored in Script Properties, never in the sheet).');
  if (!token) return;
  const clean = url.replace(/[?#].*$/, '').replace(/\/+$/, '');
  // Running setup again (a new token, say) keeps the cursor, so no row is copied twice. A different server has different row numbers: start over.
  if (props.getProperty('USAGE_SERVER_URL') !== clean) props.deleteProperty('USAGE_PULL_AFTER');
  props.setProperty('USAGE_SERVER_URL', clean);
  props.setProperty('USAGE_ADMIN_TOKEN', token);
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'pullClaudeUsage') ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('pullClaudeUsage').timeBased().everyMinutes(PULL.EVERY_MINUTES).create();
  const res = pullClaudeUsage();
  ui.alert('Claude usage pull is set up (every ' + PULL.EVERY_MINUTES + ' minutes).\nFirst pull: ' + res.events + ' compactions, ' + res.users + ' developers.');
}

/** Copies what is new. Safe to run by hand, from a trigger, or twice at once (a lock makes the second run wait or give up). */
function pullClaudeUsage() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) throw new Error('another pull is running');
  try {
    const props = PropertiesService.getScriptProperties();
    if (!props.getProperty('USAGE_SERVER_URL') || !props.getProperty('USAGE_ADMIN_TOKEN')) throw new Error('not set up: run "Set up Claude usage pull"');
    let events = 0;
    let after = Number(props.getProperty('USAGE_PULL_AFTER')) || 0;
    for (let page = 0; page < PULL.MAX_PAGES; page++) {
      const d = pullGet_('events', after);
      if (d.rows.length) {
        const sh = pullSheet_(PULL.EVENTS, d.columns);
        sh.getRange(sh.getLastRow() + 1, 1, d.rows.length, d.columns.length).setValues(d.rows.map(pullRow_));
        events += d.rows.length;
      }
      after = d.last_id;
      props.setProperty('USAGE_PULL_AFTER', String(after));      // saved after every page: a failure later never copies a row twice
      if (!d.more) break;
    }
    const u = pullGet_('users', 0);
    const ush = pullSheet_(PULL.USERS, u.columns);
    if (ush.getLastRow() > 1) ush.getRange(2, 1, ush.getLastRow() - 1, u.columns.length).clearContent();
    if (u.rows.length) ush.getRange(2, 1, u.rows.length, u.columns.length).setValues(u.rows.map(pullRow_));
    return { events: events, users: u.rows.length };
  } finally {
    lock.releaseLock();
  }
}

/** Menu item "Pull Claude usage now": the same pull, with a message instead of an exception. */
function menuPullClaudeUsage() {
  const ui = SpreadsheetApp.getUi();
  try {
    const r = pullClaudeUsage();
    ui.alert('Copied ' + r.events + ' new compactions. ' + r.users + ' developers registered.');
  } catch (e) {
    ui.alert('Could not pull Claude usage: ' + e.message);
  }
}

/** Menu helper: forget the cursor and the copied rows, then copy everything again. */
function pullClaudeUsageFromScratch() {
  PropertiesService.getScriptProperties().deleteProperty('USAGE_PULL_AFTER');
  const sh = pullSs_().getSheetByName(PULL.EVENTS);
  if (sh && sh.getLastRow() > 1) sh.getRange(2, 1, sh.getLastRow() - 1, sh.getLastColumn()).clearContent();
  return pullClaudeUsage();
}

// ============================================================ helpers
function pullGet_(table, after) {
  const props = PropertiesService.getScriptProperties();
  const base = props.getProperty('USAGE_SERVER_URL');
  const url = base + (base.indexOf('?') < 0 ? '?' : '&') + 'api=export&table=' + table + '&after=' + after + '&limit=' + PULL.PAGE;
  const r = UrlFetchApp.fetch(url, { headers: { Authorization: 'Bearer ' + props.getProperty('USAGE_ADMIN_TOKEN') }, muteHttpExceptions: true });
  const code = r.getResponseCode();
  if (code === 401) throw new Error('the server rejected the admin token');
  if (code === 403) throw new Error('export is not enabled on the server (CCKIT_ADMIN_TOKEN)');
  if (code !== 200) throw new Error('server answered HTTP ' + code);
  let d;
  try { d = JSON.parse(r.getContentText()); } catch (e) { throw new Error('the server did not answer JSON: check the URL'); }
  if (!d || !d.ok || !d.columns || !d.rows) throw new Error('unexpected answer from the server');
  return d;
}

let PULL_SS_ = null;
function pullSs_() {
  if (PULL_SS_) return PULL_SS_;
  const p = PropertiesService.getScriptProperties();
  const id = p.getProperty('USAGE_SHEET_ID') || p.getProperty('SHEET_ID');
  PULL_SS_ = id ? SpreadsheetApp.openById(id) : SpreadsheetApp.getActiveSpreadsheet();
  return PULL_SS_;
}

function pullSheet_(name, head) {
  const ss = pullSs_();
  let sh = ss.getSheetByName(name);
  if (!sh) {
    sh = ss.insertSheet(name);
    sh.getRange(1, 1, 1, head.length).setValues([head]).setFontWeight('bold').setBackground('#1F3864').setFontColor('#FFFFFF');
    sh.setFrozenRows(1);
    sh.setTabColor('#757575');
  }
  return sh;
}

/** One row for the sheet: times become dates, and text that would be read as a formula is neutralised (also done by the server; belt and braces). */
function pullRow_(row) {
  return row.map(function (v) {
    if (typeof v !== 'string') return v;
    if (/^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ$/.test(v)) return new Date(v);
    return /^[=+\-@]/.test(v) ? "'" + v : v;
  });
}
