/**
 * Claude Code usage APIs: router and shared helpers. Generated by `cckit api export` (claude-cost-kit); do not edit by hand,
 * change the package and export again. Files: Api.gs (this one), Register.gs, Usage.gs.
 *
 * TWO APIs behind one web app deployment, chosen with ?api=:
 *   POST <exec URL>?api=register   a developer registers once with a Tiger Analytics e-mail (and optionally a GitHub login)
 *                                  and gets a personal token for that machine
 *   POST <exec URL>?api=usage      reports one context compaction with the session's Claude metrics (needs the token)
 *   GET  <exec URL>?api=ping       "is it deployed and set up?"
 * Both write to this spreadsheet: tabs Claude_Users and Claude_Compactions (created on first use). Nothing from the conversation is
 * ever stored: no prompts, code, file paths or summaries.
 *
 * Safety model (anyone who has the URL can call it):
 *   - register needs the team key (Script Property USAGE_TEAM_KEY) and an e-mail on an allowed domain
 *     (Script Property USAGE_ALLOWED_DOMAINS, default tigeranalytics.com);
 *   - usage needs the per-machine token issued at registration (stored only as SHA-256 hashes);
 *   - values are length-limited and spreadsheet formulas are neutralised; hourly limits per developer and overall; repeats dropped.
 * Registration checks the e-mail's DOMAIN, it does not prove the person owns the mailbox. Treat the data as telemetry.
 *
 * Which spreadsheet: Script Property USAGE_SHEET_ID, else SHEET_ID (the Access Hub sets it), else the spreadsheet this script is bound to.
 */

const USAGE = {
  USERS: 'Claude_Users',
  EVENTS: 'Claude_Compactions',
  USER_HEAD: ['Email', 'GitHub', 'Registered At', 'GitHub Verified', 'Token Hashes', 'Active', 'Last Seen', 'Compactions', 'Note'],
  EVENT_HEAD: ['Received At', 'Event ID', 'Email', 'GitHub', 'Trigger', 'Model', 'Effort', 'Claude Version', 'Entrypoint',
    'Context Tokens', 'Window', 'Context %', 'Input Tokens', 'Output Tokens', 'Cache Read', 'Cache Write', 'Cache Hit %',
    'Requests', 'Subagent Requests', 'Subagent Output', 'Tool Calls', 'Models', 'Tools', 'Session Minutes', 'Compactions Before',
    'Project', 'Branch', 'Session', 'OS', 'Partial', 'Client'],
  MAX_BODY: 6000,
  MAX_DEVICES: 5,             // machines (tokens) per developer
  EVENTS_PER_HOUR: 120,       // per developer
  REGISTER_PER_HOUR: 30,      // for everybody together
  EMAIL_RX: /^[a-z0-9][a-z0-9._%+\-]{0,63}@([a-z0-9.\-]{3,60})$/,
  GITHUB_RX: /^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$/
};

// ============================================================ router
/** POST body is JSON text. Always answers JSON, never a stack trace. */
function doPost(e) {
  let out;
  try {
    const raw = (e && e.postData && e.postData.contents) || '';
    if (raw.length > USAGE.MAX_BODY) throw usageErr_('payload too large');
    let body;
    try { body = JSON.parse(raw); } catch (x) { throw usageErr_('body must be JSON'); }
    if (!body || typeof body !== 'object') throw usageErr_('body must be a JSON object');
    if (!usageKey_()) throw usageErr_('the usage API is not set up yet (admin: run setupUsageApi)');
    const api = e && e.parameter && e.parameter.api;
    out = usageLocked_(function () {
      if (api === 'register') return registerApi_(body);
      if (api === 'usage') return usageApi_(body);
      throw usageErr_('unknown api: use ?api=register or ?api=usage');
    });
  } catch (err) {
    out = { ok: false, error: err && err.usage ? err.message : 'server error' };
    if (!(err && err.usage)) console.error(err && err.stack || err);
  }
  return ContentService.createTextOutput(JSON.stringify(out)).setMimeType(ContentService.MimeType.JSON);
}

/** For a doGet: `if (e.parameter.api === 'ping') return apiPing_();` lets `cckit whoami --check` test the deployment without logging in. */
function apiPing_() {
  return ContentService.createTextOutput(JSON.stringify({ ok: true, service: 'cckit-usage', ready: !!usageKey_() }))
    .setMimeType(ContentService.MimeType.JSON);
}

// ============================================================ admin: run once from the editor (or a menu item)
function setupUsageApi() {
  usageSheet_(USAGE.USERS, USAGE.USER_HEAD);
  usageSheet_(USAGE.EVENTS, USAGE.EVENT_HEAD);
  const props = PropertiesService.getScriptProperties();
  if (!props.getProperty('USAGE_TEAM_KEY')) props.setProperty('USAGE_TEAM_KEY', Utilities.getUuid().replace(/-/g, '').slice(0, 16));
  if (!props.getProperty('USAGE_ALLOWED_DOMAINS')) props.setProperty('USAGE_ALLOWED_DOMAINS', 'tigeranalytics.com');
  const msg = 'Claude usage API is ready.\n\nTeam key (the join code developers use): ' + props.getProperty('USAGE_TEAM_KEY') +
    '\nAllowed e-mail domains: ' + props.getProperty('USAGE_ALLOWED_DOMAINS') +
    '\n\nNext: Deploy > New deployment > Web app, Execute as: Me, Who has access: Anyone. Put the /exec URL and the team key in cckit.toml under [telemetry].';
  try { SpreadsheetApp.getUi().alert(msg); } catch (e) { console.log(msg); }
}

// ============================================================ helpers
function usageErr_(msg) { const e = new Error(msg); e.usage = true; return e; }
function usageKey_() { return PropertiesService.getScriptProperties().getProperty('USAGE_TEAM_KEY') || ''; }

function usageDomains_() {
  return (PropertiesService.getScriptProperties().getProperty('USAGE_ALLOWED_DOMAINS') || 'tigeranalytics.com')
    .toLowerCase().split(',').map(function (s) { return s.trim(); }).filter(String);
}

/** Lower-cased e-mail on an allowed domain, or throws. */
function usageEmail_(v) {
  const e = String(v || '').trim().toLowerCase();
  const m = USAGE.EMAIL_RX.exec(e);
  const doms = usageDomains_();
  if (!m || doms.indexOf(m[1]) < 0) throw usageErr_('email must be a ' + doms.map(function (d) { return '@' + d; }).join(' or ') + ' address');
  return e;
}

let USAGE_SS_ = null;
function usageSs_() {
  if (USAGE_SS_) return USAGE_SS_;
  const p = PropertiesService.getScriptProperties();
  const id = p.getProperty('USAGE_SHEET_ID') || p.getProperty('SHEET_ID');
  USAGE_SS_ = id ? SpreadsheetApp.openById(id) : SpreadsheetApp.getActiveSpreadsheet();
  return USAGE_SS_;
}

function usageLocked_(fn) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) throw usageErr_('busy, try again');
  try { return fn(); } finally { lock.releaseLock(); }
}

/** Counts a hit in the current hour. Returns false when the limit is passed. Call it inside the lock. */
function usageBump_(name, limit) {
  const cache = CacheService.getScriptCache();
  const key = 'ub:' + name + ':' + Math.floor(Date.now() / 3600000);
  const n = (Number(cache.get(key)) || 0) + 1;
  cache.put(key, String(n), 3600);
  return n <= limit;
}

function usageSheet_(name, head) {
  const ss = usageSs_();
  let sh = ss.getSheetByName(name);
  if (!sh) {
    sh = ss.insertSheet(name);
    sh.getRange(1, 1, 1, head.length).setValues([head]).setFontWeight('bold').setBackground('#1F3864').setFontColor('#FFFFFF');
    sh.setFrozenRows(1);
    sh.setTabColor('#757575');
    if (name === USAGE.USERS) {
      sh.getRange('F2:F1000').setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['Yes', 'No'], true).build());
      sh.setColumnWidths(1, head.length, 150);
    }
  }
  return sh;
}

/** Row number (2..) of this e-mail in Claude_Users, or 0. */
function usageFindUser_(sh, email) {
  const n = sh.getLastRow();
  if (n < 2) return 0;
  const col = sh.getRange(2, 1, n - 1, 1).getValues();
  for (let i = 0; i < col.length; i++) if (String(col[i][0]).trim().toLowerCase() === email) return i + 2;
  return 0;
}

function usageHash_(s) {
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, s, Utilities.Charset.UTF_8)
    .map(function (b) { return ('0' + (b & 0xff).toString(16)).slice(-2); }).join('');
}

/** Text for a cell: limited length, no control characters, and never starts like a formula. */
function usageStr_(v, max) {
  let s = (v == null ? '' : String(v)).replace(/[\u0000-\u001f\u007f]/g, ' ').trim().slice(0, max);
  if (/^[=+\-@]/.test(s)) s = "'" + s;
  return s;
}
function usageNum_(v, max) {
  const n = Number(v);
  return isFinite(n) && n >= 0 ? Math.min(Math.round(n), max) : 0;
}
