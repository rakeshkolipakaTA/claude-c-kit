#!/usr/bin/env python3
"""PreToolUse hook (generated by cckit): shorten test-runner output without losing what failed.

Claude Code sends the hook a JSON document on stdin. For a Bash call that is a plain test run
(pytest, npm test, go test ...) we rewrite the command so that its output goes through this script
(`--trim`), which keeps: the first lines (compile and collection errors show up there), the lines that
report a failure (at most MAX_MATCHES) and the last TAIL_LINES lines (the summary). Short output is
passed through whole. The exit status of the test run is preserved (set -o pipefail). Anything else is
passed through untouched. Edit .cckit/cckit.toml and re-run `cckit init` to change the number of lines.
"""
import json
import re
import sys
from collections import deque

TAIL_LINES = __TAIL_LINES__
HEAD_LINES = 10
MAX_MATCHES = 60
FAILURE = re.compile(r"(\bFAIL(?:ED|URE)?\b|\bERROR\b|\berror\b[:\[]|\bpanic\b|Traceback|AssertionError|\bException\b|\bAssertion\b|^\s*[\u2717\u2715\u25cf]|--- FAIL|\bBUILD FAILURE\b)")

RUNNERS = (
    r"pytest|python3? -m pytest|npm test|npm run test|yarn test|pnpm test|go test|cargo test|"
    r"mvn test|mvn verify|gradle test|\./gradlew test|dotnet test"
)
# the runner plus plain arguments only: no pipes, redirects, chaining, substitutions or comments
PATTERN = re.compile(r"^(?:" + RUNNERS + r")(?: [^;&|<>`$#\\\x00-\x1f]*)?$")


def trim(lines_in, out) -> None:
    """Write the head, the failure lines and the tail of `lines_in`, with a note wherever lines were left out. Streams: memory stays small."""
    head, matches, tail = [], [], deque(maxlen=TAIL_LINES)
    total = 0
    for i, line in enumerate(lines_in):
        total = i + 1
        if i < HEAD_LINES:
            head.append((i, line))
        elif len(matches) < MAX_MATCHES and FAILURE.search(line):
            matches.append((i, line))
        tail.append((i, line))
    keep = {}
    for i, line in head + matches + list(tail):
        keep[i] = line
    last = -1
    for i in sorted(keep):
        if i != last + 1:
            out.write("[... %d lines left out ...]\n" % (i - last - 1))
        out.write(keep[i] if keep[i].endswith("\n") else keep[i] + "\n")
        last = i
    if last != total - 1 and total:
        out.write("[... %d lines left out ...]\n" % (total - 1 - last))


def main() -> None:
    if len(sys.argv) > 1 and sys.argv[1] == "--trim":
        trim(sys.stdin, sys.stdout)
        return
    try:
        data = json.load(sys.stdin)
    except Exception:
        print("{}")
        return
    if data.get("tool_name") != "Bash":
        print("{}")
        return
    tool_input = data.get("tool_input") or {}
    cmd = str(tool_input.get("command", "")).strip()
    if not PATTERN.match(cmd):
        print("{}")
        return
    new_input = dict(tool_input)
    me = __file__.replace("\\", "/")
    py = sys.executable.replace("\\", "/")
    new_input["command"] = f'set -o pipefail; {cmd} 2>&1 | "{py}" "{me}" --trim'

    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "updatedInput": new_input}}))


if __name__ == "__main__":
    main()
