#!/usr/bin/env python3
"""PreToolUse hook (generated by cckit): keep only the last N lines of test-runner output.

Claude Code sends the hook a JSON document on stdin. For a Bash call that is a plain test run
(pytest, npm test, go test ...) we rewrite the command so that only the tail of its output reaches
the model. The exit status of the test run is preserved (set -o pipefail). Anything else is passed
through untouched. Edit .cckit/cckit.toml and re-run `cckit init` to change the number of lines.
"""
import json
import re
import sys

TAIL_LINES = __TAIL_LINES__

RUNNERS = (
    r"pytest|python3? -m pytest|npm test|npm run test|yarn test|pnpm test|go test|cargo test|"
    r"mvn test|mvn verify|gradle test|\./gradlew test|dotnet test"
)
# the runner plus plain arguments only: no pipes, redirects, chaining, substitutions or comments
PATTERN = re.compile(r"^(?:" + RUNNERS + r")(?: [^;&|<>`$#\\\x00-\x1f]*)?$")


def main() -> None:
    try:
        data = json.load(sys.stdin)
    except Exception:
        print("{}")
        return
    if data.get("tool_name") != "Bash":
        print("{}")
        return
    tool_input = data.get("tool_input") or {}
    cmd = str(tool_input.get("command", "")).strip()
    if not PATTERN.match(cmd):
        print("{}")
        return
    new_input = dict(tool_input)
    new_input["command"] = f"set -o pipefail; {cmd} 2>&1 | tail -n {TAIL_LINES}"
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "updatedInput": new_input}}))


if __name__ == "__main__":
    main()
