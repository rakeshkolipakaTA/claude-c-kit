#!/usr/bin/env python3
"""Usage and cost of Claude Code sessions (generated by cckit). Run it, do not estimate token counts yourself.

  python3 .claude/scripts/usage_report.py                       this session (CLAUDE_CODE_SESSION_ID, else the newest transcript)
  python3 .claude/scripts/usage_report.py --session all --days 7   every session of this project in the last 7 days, by day and model
  python3 .claude/scripts/usage_report.py --session 8e912bca      one session (id prefix)
  options: --by day|model|session   --json   --all-projects   --top N

It reads Claude Code's local transcripts (~/.claude/projects/<project>/*.jsonl and each session's subagents/ folder): numbers and tool NAMES only,
no message text is printed or stored. Cost is an ESTIMATE from the [prices.*] tables in cckit.toml (per million tokens); the real bill is in your
admin console. Standard library only.
"""
import argparse
import json
import os
import re
import sys
from collections import Counter, defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path

PRICES = __PRICES__              # {"sonnet": {"input": 3.0, "output": 15.0, "cache_read": 0.3, "cache_write": 3.75}, ...} (USD per million tokens)
WINDOW = __WINDOW__              # the auto-compact window from cckit.toml
WARN_PCT = __WARN_PCT__


def config_dir():
    return Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")


def project_dir(root):
    return config_dir() / "projects" / re.sub(r"[^A-Za-z0-9]", "-", str(Path(root).resolve()))


def parse_ts(s):
    try:
        return datetime.fromisoformat(str(s).replace("Z", "+00:00"))
    except Exception:
        return None


def k(n):
    n = int(n)
    return "%.1fM" % (n / 1e6) if n >= 1_000_000 else ("%.1fk" % (n / 1e3) if n >= 1000 else str(n))


def price_for(model):
    for word, p in PRICES.items():
        if word.lower() in model.lower():
            return p
    return None


def cost(u, model):
    p = price_for(model)
    if not p:
        return None
    return (u["input"] * p.get("input", 0) + u["output"] * p.get("output", 0) + u["cache_read"] * p.get("cache_read", 0) + u["cache_write"] * p.get("cache_write", 0)) / 1e6


def new_tot():
    return {"requests": 0, "input": 0, "output": 0, "cache_read": 0, "cache_write": 0}


def add(t, u):
    t["requests"] += 1
    t["input"] += int(u.get("input_tokens") or 0)
    t["output"] += int(u.get("output_tokens") or 0)
    t["cache_read"] += int(u.get("cache_read_input_tokens") or 0)
    t["cache_write"] += int(u.get("cache_creation_input_tokens") or 0)


def hit(t):
    tot = t["input"] + t["cache_read"] + t["cache_write"]
    return t["cache_read"] / tot if tot else None


def read_transcript(path, sub_default=False):
    """Responses of one transcript file. One record per message id (the last line of a message carries its final counts)."""
    last, meta, compactions, tools, tool_ids = {}, {}, 0, Counter(), set()
    try:
        fh = open(path, "rb")
    except OSError:
        return [], meta, 0, tools
    with fh:
        for raw in fh:
            if b'"compact_boundary"' in raw:
                try:
                    o = json.loads(raw)
                    if o.get("type") == "system" and o.get("subtype") == "compact_boundary":
                        compactions += 1
                except ValueError:
                    pass
                continue
            if b'"usage"' not in raw:
                continue
            try:
                o = json.loads(raw)
            except ValueError:
                continue
            m = o.get("message") if isinstance(o, dict) else None
            if o.get("type") != "assistant" or not isinstance(m, dict) or not isinstance(m.get("usage"), dict):
                continue
            model = str(m.get("model") or "")
            if not model or model.startswith("<"):
                continue
            side = sub_default or bool(o.get("isSidechain"))
            last[m.get("id") or o.get("uuid") or str(len(last))] = (parse_ts(o.get("timestamp")), model, side, m["usage"])
            for blk in (m.get("content") if isinstance(m.get("content"), list) else []):
                if isinstance(blk, dict) and blk.get("type") == "tool_use" and blk.get("id") not in tool_ids:
                    tool_ids.add(blk.get("id"))
                    tools[str(blk.get("name") or "")[:40]] += 1
            if not side:
                meta = {"effort": o.get("effort") or meta.get("effort", ""), "version": o.get("version") or meta.get("version", ""),
                        "entrypoint": o.get("entrypoint") or meta.get("entrypoint", ""), "branch": o.get("gitBranch") or meta.get("branch", "")}
    return list(last.values()), meta, compactions, tools


def session_files(base):
    """(session id, [(path, is_subagent)]) for every session in a project folder."""
    out = {}
    for f in sorted(base.glob("*.jsonl")):
        out.setdefault(f.stem, []).append((f, False))
    for d in sorted(base.glob("*/subagents")):
        for f in sorted(d.glob("*.jsonl")):
            out.setdefault(d.parent.name, []).append((f, True))
    return out


def summarise(sid, files, project):
    s = {"session": sid, "project": project, "main": new_tot(), "sub": new_tot(), "models": Counter(), "compactions": 0, "tools": Counter(),
         "first": None, "last": None, "context": 0, "meta": {}, "by_model": defaultdict(new_tot), "by_day_model": defaultdict(new_tot)}
    newest_main = None
    for path, is_sub in files:
        recs, meta, comp, tools = read_transcript(path, is_sub)
        s["compactions"] += comp
        s["tools"].update(tools)
        if meta and not is_sub:
            s["meta"] = meta
        for ts, model, side, u in recs:
            add(s["sub"] if side else s["main"], u)
            add(s["by_model"][model], u)
            s["models"][model] += 1
            if ts:
                s["first"] = ts if not s["first"] or ts < s["first"] else s["first"]
                s["last"] = ts if not s["last"] or ts > s["last"] else s["last"]
                add(s["by_day_model"][(ts.date().isoformat(), model)], u)
            if not side and ts and (newest_main is None or ts >= newest_main[0]):
                newest_main = (ts, u)
    if newest_main:
        u = newest_main[1]
        s["context"] = int(u.get("input_tokens") or 0) + int(u.get("cache_read_input_tokens") or 0) + int(u.get("cache_creation_input_tokens") or 0)
    return s


def session_cost(s):
    total, unpriced = 0.0, []
    for model, t in s["by_model"].items():
        c = cost(t, model)
        if c is None:
            unpriced.append(model)
        else:
            total += c
    return (total if PRICES else None), unpriced


def describe(s):
    c, unpriced = session_cost(s)
    mt = s["main"]
    both = {k_: s["main"][k_] + s["sub"][k_] for k_ in mt}
    mins = int((s["last"] - s["first"]).total_seconds() // 60) if s["first"] and s["last"] else 0
    lines = ["Session %s  %s  (%d min)" % (s["session"][:8], (s["first"].strftime("%Y-%m-%d %H:%M") if s["first"] else "no responses yet"), mins)]
    mdl = ", ".join("%s x%d" % kv for kv in s["models"].most_common(4)) or "-"
    meta = s["meta"]
    lines.append("  models:      %s  | effort %s | %s %s" % (mdl, meta.get("effort") or "?", meta.get("entrypoint") or "?", meta.get("version") or ""))
    lines.append("  requests:    %d main + %d subagent | compactions %d | tool calls %d%s" % (
        s["main"]["requests"], s["sub"]["requests"], s["compactions"], sum(s["tools"].values()),
        (" (" + ", ".join("%s %d" % kv for kv in s["tools"].most_common(5)) + ")") if s["tools"] else ""))
    h = hit(both)
    lines.append("  tokens:      input %s (fresh %s + cache read %s + cache write %s) | output %s | cache hit %s" % (
        k(both["input"] + both["cache_read"] + both["cache_write"]), k(both["input"]), k(both["cache_read"]), k(both["cache_write"]), k(both["output"]),
        ("%.0f%%" % (h * 100)) if h is not None else "-"))
    if s["sub"]["requests"]:
        lines.append("  subagents:   %d requests, %s output tokens" % (s["sub"]["requests"], k(s["sub"]["output"])))
    pct = s["context"] * 100.0 / WINDOW if WINDOW else 0
    warn = "   <- getting full: /compact now, or /clear if the task changed" if pct >= WARN_PCT else ""
    lines.append("  context now: %s of %s tokens (%.0f%%)%s" % (k(s["context"]), k(WINDOW), pct, warn))
    if c is None:
        lines.append("  est. cost:   n/a (add a [prices.<word in model name>] table to cckit.toml, then `cckit init`)")
    else:
        lines.append("  est. cost:   $%.2f%s" % (c, ("  (no price for: %s)" % ", ".join(unpriced)) if unpriced else ""))
    return lines


def table(sessions, by, top):
    rows = defaultdict(new_tot)
    tot_cost, unpriced = 0.0, set()
    for s in sessions:
        for (day, model), t in s["by_day_model"].items():
            key = {"day": (day, model), "model": ("", model), "session": (s["session"][:8], model)}[by]
            for a in t:
                rows[key][a] += t[a]
    lines = ["Tokens by %s and model (input = fresh + cache read + cache write)" % by,
             "%-11s %-26s %6s %9s %9s %9s%s" % (by if by != "model" else "", "model", "req", "input", "output", "cache hit", "  est. $" if PRICES else "")]
    grand = new_tot()
    for key, t in sorted(rows.items()):
        h = hit(t)
        c = cost(t, key[1])
        if PRICES and c is None:
            unpriced.add(key[1])
        tot_cost += c or 0
        lines.append("%-11s %-26s %6d %9s %9s %9s%s" % (key[0], key[1][:25], t["requests"], k(t["input"] + t["cache_read"] + t["cache_write"]), k(t["output"]),
                                                      ("%.0f%%" % (h * 100)) if h is not None else "-", ("  %7s" % ("%.2f" % c if c is not None else "?")) if PRICES else ""))
        for a in t:
            grand[a] += t[a]
    h = hit(grand)
    lines.append("%-38s %6d %9s %9s %9s%s" % ("TOTAL", grand["requests"], k(grand["input"] + grand["cache_read"] + grand["cache_write"]), k(grand["output"]),
                                             ("%.0f%%" % (h * 100)) if h is not None else "-", ("  %7.2f" % tot_cost) if PRICES else ""))
    if unpriced:
        lines.append("('?' = no [prices.*] entry for: %s; the total leaves it out)" % ", ".join(sorted(unpriced)))
    heavy = sorted(sessions, key=lambda s: s["main"]["input"] + s["main"]["cache_read"] + s["main"]["cache_write"] + s["main"]["output"], reverse=True)[:top]
    lines += ["", "Heaviest sessions (top %d)" % len(heavy), "%-9s %-17s %5s %9s %9s %6s" % ("session", "start", "req", "context", "output", "compct")]
    for s in heavy:
        lines.append("%-9s %-17s %5d %9s %9s %6d%s" % (s["session"][:8], s["first"].strftime("%Y-%m-%d %H:%M") if s["first"] else "-", s["main"]["requests"] + s["sub"]["requests"],
                                                      k(s["context"]), k(s["main"]["output"] + s["sub"]["output"]), s["compactions"],
                                                      "  <- long context" if WINDOW and s["context"] * 100 / WINDOW >= WARN_PCT else ""))
    return lines


def to_json(s):
    c, unpriced = session_cost(s)
    return {"session": s["session"], "project": s["project"], "first": s["first"].isoformat() if s["first"] else None, "last": s["last"].isoformat() if s["last"] else None,
            "main": s["main"], "subagent": s["sub"], "models": dict(s["models"]), "compactions": s["compactions"], "tools": dict(s["tools"]),
            "context_tokens": s["context"], "window": WINDOW, "context_pct": round(s["context"] * 100.0 / WINDOW, 1) if WINDOW else None,
            "estimated_cost_usd": round(c, 4) if c is not None else None, "models_without_price": unpriced, **{"meta": s["meta"]}}


def main(argv=None):
    ap = argparse.ArgumentParser(description="Claude Code usage and estimated cost (local transcripts, numbers only)")
    ap.add_argument("--session", default="latest", help="latest (default) | all | a session id prefix")
    ap.add_argument("--days", type=int, help="only sessions active in the last N days (with --session all)")
    ap.add_argument("--by", choices=["day", "model", "session"], default="day")
    ap.add_argument("--top", type=int, default=8)
    ap.add_argument("--all-projects", action="store_true", help="every project, not just this one")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args(argv)
    root = os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
    bases = [d for d in (config_dir() / "projects").glob("*") if d.is_dir()] if a.all_projects else [project_dir(root)]
    sessions_files = []
    for b in bases:
        if b.is_dir():
            sessions_files += [(sid, files, b.name) for sid, files in session_files(b).items()]
    if not sessions_files:
        print("No Claude Code transcripts found for %s (looked in %s)." % (root, ", ".join(str(b) for b in bases)))
        return 1
    cutoff = datetime.now(timezone.utc) - timedelta(days=a.days) if a.days else None
    chosen = sessions_files
    if a.session == "latest":
        env = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
        match = [x for x in sessions_files if x[0] == env]
        chosen = match or [max(sessions_files, key=lambda x: max(os.path.getmtime(p) for p, _ in x[1]))]
    elif a.session != "all":
        chosen = [x for x in sessions_files if x[0].startswith(a.session)]
        if not chosen:
            print("No session starts with %r." % a.session)
            return 1
    elif cutoff:
        chosen = [x for x in sessions_files if datetime.fromtimestamp(max(os.path.getmtime(p) for p, _ in x[1]), timezone.utc) >= cutoff]
    sums = [summarise(sid, files, proj) for sid, files, proj in chosen]
    sums = [s for s in sums if s["main"]["requests"] or s["sub"]["requests"]]
    if not sums:
        print("No responses found yet.")
        return 0
    if a.json:
        print(json.dumps([to_json(s) for s in sums], indent=2))
    elif a.session == "all":
        print("\n".join(table(sums, a.by, a.top)))
    else:
        for s in sums:
            print("\n".join(describe(s)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
