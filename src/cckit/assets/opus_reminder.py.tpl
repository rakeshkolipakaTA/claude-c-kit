#!/usr/bin/env python3
"""UserPromptSubmit hook (generated by cckit): while an Opus model is in use, ask Claude to add a one-line model tip to every reply.

Claude Code runs this before each prompt and sends JSON on stdin. The hook finds the model of the newest main-agent response in the transcript
(a hook is not told the model; before the first response it falls back to $ANTHROPIC_MODEL or the "model" in the project settings). If it is an
Opus model, it prints a short instruction that is added to the prompt as context; otherwise it prints nothing and costs nothing. It never blocks.
Note: right after `/model` is changed the transcript still shows the previous model until the next response; the CLAUDE.md line covers that gap.
Switch off: cckit.toml [model] opus_reminder = false, or CCKIT_OPUS_REMINDER=off on one machine.
"""
import json
import os
import sys
from pathlib import Path

TAIL = 400_000

REMINDER = (
    "Model reminder (cckit): this session runs on an Opus model, the most expensive one. At the END of your reply add exactly one line "
    "starting with 'Model tip:' that says whether THIS task needed Opus, whatever the task was. "
    "Opus is worth it for: architecture or design decisions, hard debugging across many files, security review, large refactors or migrations, "
    "ambiguous or high-stakes requirements. Sonnet is enough for: routine edits, small bugs, writing tests or docs, explaining code, code search. "
    "Haiku is enough for: renames, formatting, simple lookups. If a cheaper model would have done, name it and give the command "
    "(for example '/model sonnet'); if Opus was needed, write 'Opus justified: <reason>'."
)


def newest_model(path):
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as f:
            f.seek(max(0, size - TAIL))
            lines = f.read().splitlines()
    except (OSError, TypeError):
        return ""
    for raw in reversed(lines):
        if b'"usage"' not in raw:
            continue
        try:
            o = json.loads(raw)
        except ValueError:
            continue
        m = o.get("message") if isinstance(o, dict) else None
        if o.get("type") == "assistant" and not o.get("isSidechain") and isinstance(m, dict):
            model = str(m.get("model") or "")
            if model and not model.startswith("<"):
                return model
    return ""


def configured_model(root):
    env = os.environ.get("ANTHROPIC_MODEL", "")
    if env:
        return env
    for name in ("settings.local.json", "settings.json"):
        try:
            d = json.loads((Path(root) / ".claude" / name).read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if isinstance(d, dict) and isinstance(d.get("model"), str) and d["model"]:
            return d["model"]
    return ""


def main():
    if os.environ.get("CCKIT_OPUS_REMINDER", "").lower() in ("off", "0", "false", "no"):
        return
    try:
        data = json.load(sys.stdin)
        root = os.environ.get("CLAUDE_PROJECT_DIR") or data.get("cwd") or "."
        model = newest_model(data.get("transcript_path")) or configured_model(root)
        if "opus" in model.lower():
            print(json.dumps({"hookSpecificOutput": {"hookEventName": "UserPromptSubmit", "additionalContext": REMINDER}}))
    except Exception:
        pass


if __name__ == "__main__":
    main()
