#!/usr/bin/env python3
"""Claude Code hook (generated by cckit): registers the developer once and reports context compactions to the team's usage API.

SessionStart  If this machine is not registered yet, take the developer's company e-mail from `git config user.email` (only an address
              on an allowed domain is used) plus, when it can be found, their GitHub login, and call the REGISTER api. If there is no
              company e-mail, ask Claude to ask the developer (at most every 3 days).
PreCompact    Call the USAGE api with what happened: model, context size and the session's Claude metrics.

Sent: company e-mail, GitHub login (optional), trigger (auto/manual), the model, reasoning effort, Claude Code version and entrypoint,
context and window size, token totals of the session (input, output, cache read/write), request counts (main and subagents), the models
used with request counts, tool NAMES with counts, session length, how many compactions came before, OS, and (if enabled) the repo folder
name and git branch. NEVER sent: prompts, code, file paths, tool inputs or outputs, the compaction summary or any conversation text.

It never blocks Claude Code (PreCompact runs in the background), prints nothing on PreCompact (that output would become part of the
compaction instructions) and fails silently. Opt out on one machine with the environment variable CCKIT_TELEMETRY=off.
Manual registration: python3 compact_report.py --register FIRSTNAME.LASTNAME@COMPANY.COM [--github LOGIN]
Edit cckit.toml and run `cckit init` to change anything here.
"""
import json
import os
import platform
import re
import subprocess
import sys
import time
import uuid
import urllib.request
from collections import Counter
from datetime import datetime
from pathlib import Path

ENDPOINT = __ENDPOINT__              # identifies this team's API on this machine (key in the identity file)
REGISTER_URL = __REGISTER_URL__
USAGE_URL = __USAGE_URL__
DOMAINS = __DOMAINS__
TEAM_KEY = __TEAM_KEY__              # a join code, not a password: it is also in cckit.toml. Empty = no automatic registration
TRIGGERS = __TRIGGERS__
WINDOW = __WINDOW__
SEND_PROJECT = __SEND_PROJECT__
FULL_READ_LIMIT = 80_000_000         # bigger transcripts: only the tail is read and the event says partial
TAIL_BYTES = 3_000_000
ASK_EVERY_SECONDS = 3 * 24 * 3600

GITHUB_RX = re.compile(r"^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$")
EMAIL_RX = re.compile(r"^[a-z0-9][a-z0-9._%+\-]{0,63}@([a-z0-9.\-]{3,60})$")
NOREPLY_RX = re.compile(r"^(?:\d+\+)?([A-Za-z0-9-]+)@users\.noreply\.github\.com$", re.I)
REMOTE_USER_RX = re.compile(r"^https?://([^/@:\s]+)(?::[^@/\s]*)?@github\.com[:/]", re.I)
NOT_A_USER = {"git", "x-access-token", "oauth2", "token", "gh", "github", "ssh"}


# ------------------------------------------------------------------ identity file (same format as `cckit register`)
def identity_path():
    env = os.environ.get("CCKIT_IDENTITY_FILE")
    if env:
        return Path(env)
    base = os.environ.get("XDG_CONFIG_HOME") or os.environ.get("APPDATA") or str(Path.home() / ".config")
    return Path(base) / "cckit" / "identity.json"


def read_json(p):
    try:
        d = json.loads(Path(p).read_text(encoding="utf-8"))
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def write_private(p, data):
    p = Path(p)
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_name(p.name + ".tmp")
    fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(json.dumps(data, indent=2) + "\n")
    os.replace(str(tmp), str(p))


def load_identity():
    rec = read_json(identity_path()).get(ENDPOINT)
    return rec if isinstance(rec, dict) and rec.get("email") and rec.get("token") else None


def save_identity(email, github, token):
    data = read_json(identity_path())
    data[ENDPOINT] = {"email": email, "github": github or "", "token": token}
    write_private(identity_path(), data)


# ------------------------------------------------------------------ finding the e-mail and the GitHub login
def run(cmd, cwd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5, cwd=cwd or None).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def email_ok(e):
    m = EMAIL_RX.match((e or "").strip().lower())
    return bool(m) and m.group(1) in [d.lower() for d in DOMAINS]


def detect_email(cwd):
    """(email, source) or None. Same rules as cckit.identity.detect_email: only an address on an allowed domain is ever used."""
    for src, v in (("CCKIT_EMAIL", os.environ.get("CCKIT_EMAIL", "")), ("git config user.email", run(["git", "config", "--get", "user.email"], cwd))):
        if v and email_ok(v):
            return v.strip().lower(), src
    return None


def detect_github(cwd):
    """(login, source) or None. Optional extra. Same rules as cckit.identity.detect_github (`git config user.name` is a display name: not used)."""
    v = os.environ.get("CCKIT_GITHUB", "")
    if GITHUB_RX.match(v):
        return v, "CCKIT_GITHUB"
    v = run(["git", "config", "--get", "github.user"], cwd)
    if GITHUB_RX.match(v):
        return v, "git config github.user"
    m = NOREPLY_RX.match(run(["git", "config", "--get", "user.email"], cwd))
    if m and GITHUB_RX.match(m.group(1)):
        return m.group(1), "your git commit email (GitHub no-reply address)"
    v = run(["gh", "api", "user", "--jq", ".login"], cwd)
    if GITHUB_RX.match(v):
        return v, "the GitHub CLI (gh)"
    for ln in run(["git", "config", "--get-regexp", r"^remote\..*\.url$"], cwd).splitlines():
        m = REMOTE_USER_RX.match(ln.split(None, 1)[-1])
        if m and m.group(1).lower() not in NOT_A_USER and GITHUB_RX.match(m.group(1)):
            return m.group(1), "a git remote URL"
    for k in ("GITHUB_USER", "GITHUB_ACTOR"):
        if GITHUB_RX.match(os.environ.get(k, "")):
            return os.environ[k], k
    return None


# ------------------------------------------------------------------ the two APIs
def post(url, payload, timeout):
    req = urllib.request.Request(url, data=json.dumps(payload).encode("utf-8"), method="POST",
                                 headers={"Content-Type": "text/plain;charset=utf-8", "User-Agent": "cckit"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        d = json.loads(r.read().decode("utf-8", "replace"))
    return d if isinstance(d, dict) else {}


def register(email, github):
    """(ok, message). On success the token is saved for this machine."""
    if not email_ok(email):
        return False, "email must be a %s address" % " or ".join("@" + d for d in DOMAINS)
    try:
        d = post(REGISTER_URL, {"v": 1, "email": email.strip().lower(), "github": github or "", "team_key": TEAM_KEY}, 15)
    except Exception as e:
        return False, "could not reach the usage endpoint (%s)" % getattr(e, "reason", e)
    if d.get("ok") and d.get("token"):
        save_identity(d.get("email") or email.strip().lower(), d.get("github") or github or "", d["token"])
        return True, d.get("email") or email
    return False, str(d.get("error") or "registration failed")


def ts(s):
    try:
        return datetime.fromisoformat(str(s).replace("Z", "+00:00"))
    except Exception:
        return None


def session_metrics(path):
    """One pass over the transcript. Numbers and short names only; no message text is kept."""
    m = {"model": "", "effort": "", "claude_version": "", "entrypoint": "", "branch": "", "context_tokens": 0, "partial": False,
         "input_tokens": 0, "output_tokens": 0, "cache_read": 0, "cache_write": 0, "requests": 0, "sub_requests": 0, "sub_output": 0,
         "tool_calls": 0, "models": "", "tools": "", "session_minutes": 0, "compactions_before": 0}
    try:
        size = os.path.getsize(path)
        f = open(path, "rb")
    except (OSError, TypeError):
        return m
    with f:
        if size > FULL_READ_LIMIT:
            f.seek(size - TAIL_BYTES)
            f.readline()
            m["partial"] = True
        last, tool_ids, first_ts, last_ts, newest_main = {}, {}, None, None, None
        for raw in f:
            if b'"compact_boundary"' in raw:
                try:
                    o = json.loads(raw)
                    if o.get("type") == "system" and o.get("subtype") == "compact_boundary":
                        m["compactions_before"] += 1
                except ValueError:
                    pass
                continue
            if b'"usage"' not in raw:
                continue
            try:
                o = json.loads(raw)
            except ValueError:
                continue
            msg = o.get("message") if isinstance(o, dict) else None
            if o.get("type") != "assistant" or not isinstance(msg, dict) or not isinstance(msg.get("usage"), dict):
                continue
            model = str(msg.get("model") or "")
            if not model or model.startswith("<"):
                continue
            side = bool(o.get("isSidechain"))
            # a response is written once per content block with growing counts: the last line of a message id has the final totals
            last[msg.get("id") or o.get("uuid") or str(len(last))] = (model, msg["usage"], side)
            for blk in (msg.get("content") if isinstance(msg.get("content"), list) else []):
                if isinstance(blk, dict) and blk.get("type") == "tool_use" and blk.get("id"):
                    tool_ids[blk["id"]] = str(blk.get("name") or "")[:40]
            t = ts(o.get("timestamp"))
            if t:
                first_ts = first_ts or t
                last_ts = t
            if not side:
                newest_main = (model, msg["usage"], o)
        models, tools = Counter(), Counter(tool_ids.values())
        for model, u, side in last.values():
            models[model] += 1
            if side:
                m["sub_requests"] += 1
                m["sub_output"] += int(u.get("output_tokens") or 0)
            else:
                m["requests"] += 1
                m["input_tokens"] += int(u.get("input_tokens") or 0)
                m["output_tokens"] += int(u.get("output_tokens") or 0)
                m["cache_read"] += int(u.get("cache_read_input_tokens") or 0)
                m["cache_write"] += int(u.get("cache_creation_input_tokens") or 0)
        m["tool_calls"] = len(tool_ids)
        m["models"] = ";".join("%s:%d" % kv for kv in models.most_common(6))
        m["tools"] = ";".join("%s:%d" % kv for kv in tools.most_common(8))
        if first_ts and last_ts:
            m["session_minutes"] = max(0, int((last_ts - first_ts).total_seconds() // 60))
        if newest_main:
            model, u, o = newest_main
            m["model"] = model
            m["context_tokens"] = sum(int(u.get(k) or 0) for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
            m["effort"] = str(o.get("effort") or "")
            m["claude_version"] = str(o.get("version") or "")
            m["entrypoint"] = str(o.get("entrypoint") or "")
            m["branch"] = str(o.get("gitBranch") or "")
    return m


def report(data, ident):
    trigger = data.get("trigger") if data.get("trigger") in ("auto", "manual") else "auto"
    if trigger not in TRIGGERS:
        return
    m = session_metrics(data.get("transcript_path"))
    cwd = str(data.get("cwd") or "").rstrip("/\\")
    payload = dict(m, v=1, email=ident["email"], token=ident["token"], event_id=uuid.uuid4().hex, trigger=trigger, window=WINDOW,
                   project=os.path.basename(cwd) if SEND_PROJECT else "", session=str(data.get("session_id") or ""),
                   os=platform.system(), client="cckit-hook/3")
    if not SEND_PROJECT:
        payload["branch"] = ""
    post(USAGE_URL, payload, 10)


# ------------------------------------------------------------------ SessionStart: register, or ask Claude to ask
def asked_recently():
    return time.time() - float(read_json(identity_path().with_name("asked.json")).get(ENDPOINT) or 0) < ASK_EVERY_SECONDS


def mark_asked():
    p = identity_path().with_name("asked.json")
    d = read_json(p)
    d[ENDPOINT] = time.time()
    write_private(p, d)


def auto_register(cwd):
    """(registered?, message for the user, ask?). ask=True when only the developer can supply the e-mail."""
    em = detect_email(cwd)
    if not em:
        return False, "", True
    gh = detect_github(cwd)
    ok, msg = register(em[0], gh[0] if gh else "")
    if ok:
        extra = " with GitHub login '%s' (from %s)" % gh if gh else ""
        return True, "Claude cost kit: registered %s (taken from %s)%s for compaction reports. Opt out with CCKIT_TELEMETRY=off." % (msg, em[1], extra), False
    return False, "", msg.startswith("email ")           # a rejected e-mail needs the developer; network or server trouble: retry next session


def session_start(data):
    if load_identity() or not TEAM_KEY:
        return
    cwd = str(data.get("cwd") or os.environ.get("CLAUDE_PROJECT_DIR") or "")
    ok, note, ask = auto_register(cwd)
    if ok:
        print(json.dumps({"systemMessage": note}))
        return
    if not ask or asked_recently():
        return
    mark_asked()
    script = os.path.join(os.environ.get("CLAUDE_PROJECT_DIR") or cwd or ".", ".claude", "hooks", "compact_report.py")
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext":
        "This repo reports Claude Code usage to the team (company e-mail, model and token counts only), but this machine is not registered and "
        "no %s e-mail was found in git config. In your first reply, ask the user for their company e-mail address, then run: "
        "python3 \"%s\" --register THEIR_EMAIL . If they decline, do nothing and do not ask again."
        % (" / ".join("@" + d for d in DOMAINS), script)}}))


def main():
    if len(sys.argv) >= 3 and sys.argv[1] == "--register":
        gh = sys.argv[sys.argv.index("--github") + 1] if "--github" in sys.argv[:-1] else ""
        ok, msg = register(sys.argv[2], gh)
        print(("Registered %s." % msg) if ok else ("error: %s" % msg))
        sys.exit(0 if ok else 1)
    try:
        if os.environ.get("CCKIT_TELEMETRY", "").lower() in ("off", "0", "false", "no"):
            return
        data = json.load(sys.stdin)
        event = data.get("hook_event_name")
        if event == "SessionStart":
            session_start(data)
        elif event == "PreCompact":
            ident = load_identity()
            if not ident and TEAM_KEY:                  # the session started before registration was possible: try once more
                if auto_register(str(data.get("cwd") or os.environ.get("CLAUDE_PROJECT_DIR") or ""))[0]:
                    ident = load_identity()
            if ident:
                report(data, ident)
    except Exception:
        pass


if __name__ == "__main__":
    main()
