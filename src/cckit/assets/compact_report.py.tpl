#!/usr/bin/env python3
"""Claude Code hook (generated by cckit): registers the developer once and reports context compactions to the team's usage API.

SessionStart  If this machine is not registered yet, take the developer's company e-mail from `git config user.email` (only an address
              on an allowed domain is used) plus, when it can be found, their GitHub login, and call the REGISTER api. If there is no
              company e-mail, show a one-line note (at most every 3 days) saying to set `git config user.email`; nobody is asked for an e-mail.
PreCompact    Call the USAGE api with what happened: model, context size and the session's Claude metrics.

Sent: company e-mail, GitHub login (optional), how the developer is billed ("subscription" or "metered", the plan such as team or bedrock) and, for a Claude login, its plan details (organisation name and type, seat tier, billing type, whether extra usage is on, rate-limit tier; never the login's e-mail, name, ids or tokens), trigger (auto/manual), the model, reasoning effort, Claude Code version and entrypoint,
context size and the window and percentage compaction is set to, token totals of the session (input, output, cache read/write), request counts (main and subagents), the models
used with request counts, tool NAMES with counts, session length, how many compactions came before, OS, and (if enabled) the repo folder
name and git branch. NEVER sent: prompts, code, file paths, tool inputs or outputs, the compaction summary or any conversation text.

It never blocks Claude Code (PreCompact runs in the background), prints nothing on PreCompact (that output would become part of the
compaction instructions) and fails silently. Opt out on one machine with the environment variable CCKIT_TELEMETRY=off.
Manual registration: python3 compact_report.py --register FIRSTNAME.LASTNAME@COMPANY.COM [--github LOGIN]
Edit .cckit/cckit.toml and run `cckit init` to change anything here.
"""
import json
import shutil
import os
import platform
import re
import subprocess
import sys
import time
import uuid
import urllib.request
from collections import Counter
from datetime import datetime
from pathlib import Path

ENDPOINT = __ENDPOINT__              # identifies this team's API on this machine (key in the identity file)
REGISTER_URL = __REGISTER_URL__
USAGE_URL = __USAGE_URL__
DOMAINS = __DOMAINS__
AUTO_REGISTER = __AUTO_REGISTER__    # .cckit/cckit.toml [telemetry] auto_register
TRIGGERS = __TRIGGERS__
WINDOW = __WINDOW__
SEND_PROJECT = __SEND_PROJECT__
FULL_READ_LIMIT = 80_000_000         # bigger transcripts: only the tail is read and the event says partial
TAIL_BYTES = 3_000_000
ASK_EVERY_SECONDS = 3 * 24 * 3600

GITHUB_RX = re.compile(r"^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$")
EMAIL_RX = re.compile(r"^[a-z0-9][a-z0-9._%+\-]{0,63}@([a-z0-9.\-]{3,60})$")
NOREPLY_RX = re.compile(r"^(?:\d+\+)?([A-Za-z0-9-]+)@users\.noreply\.github\.com$", re.I)
REMOTE_USER_RX = re.compile(r"^https?://([^/@:\s]+)(?::[^@/\s]*)?@github\.com[:/]", re.I)
NOT_A_USER = {"git", "x-access-token", "oauth2", "token", "gh", "github", "ssh"}


# ------------------------------------------------------------------ identity file (same format as `cckit register`)
def identity_path():
    env = os.environ.get("CCKIT_IDENTITY_FILE")
    if env:
        return Path(env)
    base = os.environ.get("XDG_CONFIG_HOME") or os.environ.get("APPDATA") or str(Path.home() / ".config")
    return Path(base) / "cckit" / "identity.json"


def team_key():
    """The join code: $CCKIT_TEAM_KEY, else .cckit/key.json ({"key": "..."}) in the project. Read at run time, so it is never copied into this script."""
    if not AUTO_REGISTER:
        return ""
    k = os.environ.get("CCKIT_TEAM_KEY", "")
    if not k:
        k = read_json(Path(os.environ.get("CLAUDE_PROJECT_DIR") or ".") / ".cckit" / "key.json").get("key", "")
    return k if isinstance(k, str) else ""


def read_json(p):
    try:
        d = json.loads(Path(p).read_text(encoding="utf-8"))
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def write_private(p, data):
    p = Path(p)
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_name(p.name + ".tmp")
    fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(json.dumps(data, indent=2) + "\n")
    os.replace(str(tmp), str(p))


def valid_record(rec):
    return isinstance(rec, dict) and bool(rec.get("email")) and bool(rec.get("token"))


def pick_identity(cwd, always_git=False):
    """(record to use here, the company e-mail git config names or None). One record per e-mail is kept; the one matching the repo's git e-mail is
    used, else the default (registered last). With a single record git is not asked (fast path for hooks that run every turn) unless always_git."""
    data = read_json(identity_path())
    default = data.get(ENDPOINT) if valid_record(data.get(ENDPOINT)) else None
    emails = {str(v["email"]).lower() for k, v in data.items() if (k == ENDPOINT or k.startswith(ENDPOINT + "|")) and valid_record(v)}
    if len(emails) <= 1 and not always_git:
        return default, None
    found = detect_email(cwd)
    git_email = found[0] if found else None
    rec = data.get(ENDPOINT + "|" + git_email) if git_email else None
    if not valid_record(rec) and default and git_email and str(default["email"]).lower() == git_email:
        rec = default
    return (rec if valid_record(rec) else default), git_email


def load_identity(cwd=None):
    return pick_identity(cwd or os.environ.get("CLAUDE_PROJECT_DIR") or "")[0]


def save_identity(email, github, token):
    """Keep this e-mail's record and make it the default."""
    data = read_json(identity_path())
    rec = {"email": email, "github": github or "", "token": token}
    data[ENDPOINT] = rec
    data[ENDPOINT + "|" + email.lower()] = dict(rec)
    write_private(identity_path(), data)


# ------------------------------------------------------------------ finding the e-mail and the GitHub login
def run(cmd, cwd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5, cwd=cwd or None).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def email_ok(e):
    m = EMAIL_RX.match((e or "").strip().lower())
    return bool(m) and m.group(1) in [d.lower() for d in DOMAINS]


def detect_email(cwd):
    """(email, source) or None. Same rules as cckit.identity.detect_email: only an address on an allowed domain is ever used."""
    for src, v in (("CCKIT_EMAIL", os.environ.get("CCKIT_EMAIL", "")), ("git config user.email", run(["git", "config", "--get", "user.email"], cwd))):
        if v and email_ok(v):
            return v.strip().lower(), src
    return None


def detect_github(cwd):
    """(login, source) or None. Optional extra. Same rules as cckit.identity.detect_github (`git config user.name` is a display name: not used; the `gh` CLI is not asked: its account can be someone else's)."""
    v = os.environ.get("CCKIT_GITHUB", "")
    if GITHUB_RX.match(v):
        return v, "CCKIT_GITHUB"
    v = run(["git", "config", "--get", "github.user"], cwd)
    if GITHUB_RX.match(v):
        return v, "git config github.user"
    m = NOREPLY_RX.match(run(["git", "config", "--get", "user.email"], cwd))
    if m and GITHUB_RX.match(m.group(1)):
        return m.group(1), "your git commit email (GitHub no-reply address)"
    for ln in run(["git", "config", "--get-regexp", r"^remote\..*\.url$"], cwd).splitlines():
        m = REMOTE_USER_RX.match(ln.split(None, 1)[-1])
        if m and m.group(1).lower() not in NOT_A_USER and GITHUB_RX.match(m.group(1)):
            return m.group(1), "a git remote URL"
    for k in ("GITHUB_USER", "GITHUB_ACTOR"):
        if GITHUB_RX.match(os.environ.get(k, "")):
            return os.environ[k], k
    return None


# ------------------------------------------------------------------ the two APIs
def post(url, payload, timeout):
    req = urllib.request.Request(url, data=json.dumps(payload).encode("utf-8"), method="POST",
                                 headers={"Content-Type": "text/plain;charset=utf-8", "User-Agent": "cckit"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        d = json.loads(r.read().decode("utf-8", "replace"))
    return d if isinstance(d, dict) else {}


def register(email, github):
    """(ok, message). On success the token is saved for this machine."""
    if not email_ok(email):
        return False, "email must be a %s address" % " or ".join("@" + d for d in DOMAINS)
    try:
        d = post(REGISTER_URL, {"v": 1, "email": email.strip().lower(), "github": github or "", "team_key": team_key()}, 15)
    except Exception as e:
        return False, "could not reach the usage endpoint (%s)" % getattr(e, "reason", e)
    if d.get("ok") and d.get("token"):
        save_identity(d.get("email") or email.strip().lower(), d.get("github") or github or "", d["token"])
        return True, d.get("email") or email
    return False, str(d.get("error") or "registration failed")


BILLING = __BILLING__                # .cckit/cckit.toml [usage] billing: auto | metered | subscription
LOGIN_FIELDS = ("org_name", "org_type", "seat_tier", "billing_type", "extra_usage", "rate_limit_tier")


def truthy(name):
    return os.environ.get(name, "").strip().lower() in ("1", "true", "yes", "on")


def clean(v, n=40):
    return re.sub(r"[^A-Za-z0-9 _.\-]", "", v)[:n].strip() if isinstance(v, str) else ""


def read_json(p):
    try:
        d = json.loads(Path(p).read_text(encoding="utf-8"))
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}


def login_info():
    """What Claude Code knows about the account it is logged in to, only the fields about the PLAN: subscription (pro, max, team, enterprise), organisation
    name and type, seat tier, billing type, whether extra (pay-per-token) usage is switched on, rate-limit tier. Read from its own files (.credentials.json and
    .claude.json), else `claude auth status`. The e-mail, name, ids and tokens of the login are never read into the result or sent."""
    home = Path(os.environ.get("CLAUDE_CONFIG_DIR") or (Path.home() / ".claude"))
    cred = read_json(home / ".credentials.json").get("claudeAiOauth")
    cred = cred if isinstance(cred, dict) else {}
    acct = read_json((home / ".claude.json") if os.environ.get("CLAUDE_CONFIG_DIR") else (Path.home() / ".claude.json")).get("oauthAccount")
    acct = acct if isinstance(acct, dict) else {}
    plan = clean(cred.get("subscriptionType"), 20).lower()
    org = clean(acct.get("organizationName"), 60)
    if not plan or not org:
        exe = shutil.which("claude")
        if exe:
            try:
                d = json.loads(subprocess.run([exe, "auth", "status"], capture_output=True, text=True, timeout=5).stdout)
                if d.get("authMethod") == "claude.ai":
                    plan = plan or clean(d.get("subscriptionType"), 20).lower()
                    org = org or clean(d.get("orgName"), 60)
            except Exception:
                pass
    extra = acct.get("hasExtraUsageEnabled")
    return {"plan": plan, "org_name": org, "org_type": clean(acct.get("organizationType")), "seat_tier": clean(acct.get("seatTier")),
            "billing_type": clean(acct.get("billingType")), "extra_usage": "yes" if extra is True else "no" if extra is False else "",
            "rate_limit_tier": clean(cred.get("rateLimitTier") or acct.get("userRateLimitTier"))}


def detect_billing(cache=None):
    """How the developer who runs this session is billed, as a dict: billing ("subscription" = a Claude.ai login: a Pro, Max, Team or Enterprise seat, no cost
    per token; "metered" = an API key or a cloud provider (Bedrock, Vertex, Foundry), billed per token; "unknown"), plan (pro | max | team | enterprise | api |
    bedrock | vertex | foundry) and, for a login, the LOGIN_FIELDS. [usage] billing in the config overrides "billing" for the whole repo."""
    sig = [truthy("CLAUDE_CODE_USE_BEDROCK"), truthy("CLAUDE_CODE_USE_VERTEX"), truthy("CLAUDE_CODE_USE_FOUNDRY"),
           bool(os.environ.get("ANTHROPIC_API_KEY") or os.environ.get("ANTHROPIC_AUTH_TOKEN"))]
    if isinstance(cache, dict) and cache.get("sig") == sig and time.time() - float(cache.get("at") or 0) < 43200 and isinstance(cache.get("v"), dict):
        out = dict(cache["v"])
    else:
        out = {"billing": "unknown", "plan": ""}
        for i, name in enumerate(("bedrock", "vertex", "foundry", "api")):
            if sig[i]:
                out = {"billing": "metered", "plan": name}              # a provider or key decides; the login's account is not what is billed
                break
        else:
            info = login_info()
            out = dict(info, billing="subscription" if info["plan"] else "unknown")
        if isinstance(cache, dict):
            cache.clear()
            cache.update({"sig": sig, "at": time.time(), "v": dict(out)})
    if BILLING in ("metered", "subscription"):
        out["billing"] = BILLING
    return out


def env_int(name, lo, hi):
    try:
        v = int(os.environ.get(name, ""))
    except ValueError:
        return None
    return v if lo <= v <= hi else None


def effective_window():
    """The context window auto-compaction works with on this machine: what Claude Code was started with (CLAUDE_CODE_AUTO_COMPACT_WINDOW, from
    settings.json or the developer's own environment), else the value in .cckit/cckit.toml. A developer who changed it is reported with their number."""
    return env_int("CLAUDE_CODE_AUTO_COMPACT_WINDOW", 10_000, 10_000_000) or WINDOW


def effective_pct():
    """The percentage of that window at which auto-compaction starts (CLAUDE_AUTOCOMPACT_PCT_OVERRIDE), or 0 when it is not set."""
    return env_int("CLAUDE_AUTOCOMPACT_PCT_OVERRIDE", 1, 100) or 0


def ts(s):
    try:
        return datetime.fromisoformat(str(s).replace("Z", "+00:00"))
    except Exception:
        return None


def session_metrics(path):
    """One pass over the transcript. Numbers and short names only; no message text is kept."""
    m = {"model": "", "effort": "", "claude_version": "", "entrypoint": "", "branch": "", "context_tokens": 0, "partial": False,
         "input_tokens": 0, "output_tokens": 0, "cache_read": 0, "cache_write": 0, "requests": 0, "sub_requests": 0, "sub_output": 0,
         "tool_calls": 0, "models": "", "tools": "", "session_minutes": 0, "compactions_before": 0}
    try:
        size = os.path.getsize(path)
        f = open(path, "rb")
    except (OSError, TypeError):
        return m
    with f:
        if size > FULL_READ_LIMIT:
            f.seek(size - TAIL_BYTES)
            f.readline()
            m["partial"] = True
        last, tool_ids, first_ts, last_ts, newest_main = {}, {}, None, None, None
        for raw in f:
            if b'"compact_boundary"' in raw:
                try:
                    o = json.loads(raw)
                    if o.get("type") == "system" and o.get("subtype") == "compact_boundary":
                        m["compactions_before"] += 1
                except ValueError:
                    pass
                continue
            if b'"usage"' not in raw:
                continue
            try:
                o = json.loads(raw)
            except ValueError:
                continue
            msg = o.get("message") if isinstance(o, dict) else None
            if o.get("type") != "assistant" or not isinstance(msg, dict) or not isinstance(msg.get("usage"), dict):
                continue
            model = str(msg.get("model") or "")
            if not model or model.startswith("<"):
                continue
            side = bool(o.get("isSidechain"))
            # a response is written once per content block with growing counts: the last line of a message id has the final totals
            last[msg.get("id") or o.get("uuid") or str(len(last))] = (model, msg["usage"], side)
            for blk in (msg.get("content") if isinstance(msg.get("content"), list) else []):
                if isinstance(blk, dict) and blk.get("type") == "tool_use" and blk.get("id"):
                    tool_ids[blk["id"]] = str(blk.get("name") or "")[:40]
            t = ts(o.get("timestamp"))
            if t:
                first_ts = first_ts or t
                last_ts = t
            if not side:
                newest_main = (model, msg["usage"], o)
        models, tools = Counter(), Counter(tool_ids.values())
        for model, u, side in last.values():
            models[model] += 1
            if side:
                m["sub_requests"] += 1
                m["sub_output"] += int(u.get("output_tokens") or 0)
            else:
                m["requests"] += 1
                m["input_tokens"] += int(u.get("input_tokens") or 0)
                m["output_tokens"] += int(u.get("output_tokens") or 0)
                m["cache_read"] += int(u.get("cache_read_input_tokens") or 0)
                m["cache_write"] += int(u.get("cache_creation_input_tokens") or 0)
        m["tool_calls"] = len(tool_ids)
        m["models"] = ";".join("%s:%d" % kv for kv in models.most_common(6))
        m["tools"] = ";".join("%s:%d" % kv for kv in tools.most_common(8))
        if first_ts and last_ts:
            m["session_minutes"] = max(0, int((last_ts - first_ts).total_seconds() // 60))
        if newest_main:
            model, u, o = newest_main
            m["model"] = model
            m["context_tokens"] = sum(int(u.get(k) or 0) for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
            m["effort"] = str(o.get("effort") or "")
            m["claude_version"] = str(o.get("version") or "")
            m["entrypoint"] = str(o.get("entrypoint") or "")
            m["branch"] = str(o.get("gitBranch") or "")
    return m


def report(data, ident):
    trigger = data.get("trigger") if data.get("trigger") in ("auto", "manual") else "auto"
    if trigger not in TRIGGERS:
        return
    m = session_metrics(data.get("transcript_path"))
    cwd = str(data.get("cwd") or "").rstrip("/\\")
    bill = detect_billing()
    payload = dict(m, v=1, email=ident["email"], token=ident["token"], event_id=uuid.uuid4().hex, trigger=trigger, window=effective_window(), compact_pct=effective_pct(),
                   project=os.path.basename(cwd) if SEND_PROJECT else "", session=str(data.get("session_id") or ""),
                   os=platform.system(), client="cckit-hook/5", **{k: bill.get(k, "") for k in ("billing", "plan") + LOGIN_FIELDS})
    if not SEND_PROJECT:
        payload["branch"] = ""
    post(USAGE_URL, payload, 10)


# ------------------------------------------------------------------ SessionStart: register, or say what to set in git
def asked_recently():
    return time.time() - float(read_json(identity_path().with_name("asked.json")).get(ENDPOINT) or 0) < ASK_EVERY_SECONDS


def mark_asked():
    p = identity_path().with_name("asked.json")
    d = read_json(p)
    d[ENDPOINT] = time.time()
    write_private(p, d)


def auto_register(cwd):
    """(registered?, message for the user, tell?). tell=True when git names no usable company e-mail, so the developer should be told once in a while."""
    em = detect_email(cwd)
    if not em:
        return False, "", True
    gh = detect_github(cwd)
    ok, msg = register(em[0], gh[0] if gh else "")
    if ok:
        extra = " with GitHub login '%s' (from %s)" % gh if gh else ""
        return True, "Claude cost kit: registered %s (taken from %s)%s for compaction reports. Opt out with CCKIT_TELEMETRY=off." % (msg, em[1], extra), False
    return False, "", msg.startswith("email ")           # a rejected e-mail needs the developer; network or server trouble: retry next session


def session_start(data):
    cwd = str(data.get("cwd") or os.environ.get("CLAUDE_PROJECT_DIR") or "")
    rec, git_email = pick_identity(cwd, always_git=True)
    if rec and not (git_email and str(rec["email"]).lower() != git_email):
        return                                          # registered for this repo (or git names no company e-mail, and some record exists)
    if not team_key():
        return
    ok, note, ask = auto_register(cwd)
    if ok:
        print(json.dumps({"systemMessage": note}))
        return
    if not ask or asked_recently():
        return
    mark_asked()
    print(json.dumps({"systemMessage": "Claude cost kit: usage is not reported for you, because git has no %s e-mail. Run `git config user.email firstname.lastname@%s` "
                                       "in this repo and restart Claude Code. (This note shows at most every 3 days.)" % (" / ".join("@" + d for d in DOMAINS), DOMAINS[0])}))


def main():
    if len(sys.argv) >= 3 and sys.argv[1] == "--register":
        gh = sys.argv[sys.argv.index("--github") + 1] if "--github" in sys.argv[:-1] else ""
        ok, msg = register(sys.argv[2], gh)
        print(("Registered %s." % msg) if ok else ("error: %s" % msg))
        sys.exit(0 if ok else 1)
    if os.environ.get("CCKIT_DISABLED", "").lower() in ("1", "true", "yes", "on"):      # per-machine off switch: every cckit hook does nothing
        return
    try:
        if os.environ.get("CCKIT_TELEMETRY", "").lower() in ("off", "0", "false", "no"):
            return
        data = json.load(sys.stdin)
        event = data.get("hook_event_name")
        if event == "SessionStart":
            session_start(data)
        elif event == "PreCompact":
            cwd = str(data.get("cwd") or os.environ.get("CLAUDE_PROJECT_DIR") or "")
            ident = load_identity(cwd)
            if not ident and team_key():                  # the session started before registration was possible: try once more
                if auto_register(cwd)[0]:
                    ident = load_identity(cwd)
            if ident:
                report(data, ident)
    except Exception:
        pass


if __name__ == "__main__":
    main()
